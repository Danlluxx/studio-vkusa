[Unit]
Description=Studio Vkusa Astro website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studio-vkusa
Group=studio-vkusa
WorkingDirectory=/opt/studio-vkusa/web
EnvironmentFile=/etc/studio-vkusa.env
ExecStart=/usr/bin/node /opt/studio-vkusa/web/dist/server/entry.mjs
Restart=on-failure
RestartSec=5s
StateDirectory=studio-vkusa
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/studio-vkusa

[Install]
WantedBy=multi-user.target
