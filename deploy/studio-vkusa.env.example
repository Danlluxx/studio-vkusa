# Install as /etc/studio-vkusa.env, owned by root with mode 0600.
# Use systemd EnvironmentFile syntax: KEY=value (no `export`).
NODE_ENV=production
HOST=127.0.0.1
PORT=4321
DATA_DIR=/var/lib/studio-vkusa
CANONICAL_HOST=www.studio-vkusa.ru
TZ_OFFSET_H=7
COMPRESS=0

# Initial admin is created only if the database has no users.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Optional: configure notifications here or in the admin panel.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_TO=Info@studio-vkusa.ru
