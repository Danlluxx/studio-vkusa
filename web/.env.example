# --- Админка ---
# Первый администратор создаётся при первом запуске из этих значений (пароль от 10 символов).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# --- Данные ---
# Папка с базой (site.db) и загруженными фото. По умолчанию ./data
# DATA_DIR=/var/lib/studio-vkusa
# Часовой пояс аналитики (Барнаул = 7)
# TZ_OFFSET_H=7
# --- Уведомления (можно также указать в админке: Настройки) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_TO=Info@studio-vkusa.ru
# --- SEO ---
# Главный домен: все остальные (и технические) уходят на него 301-редиректом
# CANONICAL_HOST=www.studio-vkusa.ru
