---
import { NAV } from '../data/nav';
import { SITE, wa, tg, max } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-cream/85 backdrop-blur-md">
  <div class="container-x flex h-20 items-center gap-6">
    <a href="/" class="shrink-0" aria-label="Студия Вкуса — на главную">
      <img src="/logo-128.webp" srcset="/logo-128.webp 1x, /logo-256.webp 2x" alt="Студия Вкуса — кулинарная школа №1" width="64" height="64" fetchpriority="high" class="h-16 w-16 rounded-full object-contain mix-blend-multiply" />
    </a>
    <nav class="hidden flex-1 items-center justify-center gap-1 lg:flex" aria-label="Основное меню">
      {NAV.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}
          class="whitespace-nowrap rounded-full px-3.5 py-2 text-[15px] font-medium text-ink-soft transition hover:bg-cream-deep hover:text-ink aria-[current=page]:text-brand">{n.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-3 lg:ml-0">
      <a href={SITE.phoneHref} class="hidden text-right leading-tight xl:block">
        <span class="block text-[15px] font-bold">{SITE.phone}</span>
        <span class="block text-xs text-ink-soft">ежедневно 12:00–23:00</span>
      </a>
      <a href="/zayavka/" id="basket-link" class="relative hidden h-11 items-center gap-2 rounded-full border border-ink/15 px-4 text-sm font-semibold hover:border-ink sm:inline-flex" aria-label="Список блюд для заявки">
        Моя заявка <span id="basket-count" class="hidden min-w-5 rounded-full bg-brand px-1.5 text-center text-xs leading-5 text-white">0</span>
      </a>
      <button type="button" data-lead class="btn btn-primary hidden !py-2.5 sm:inline-flex">Рассчитать</button>
      <button type="button" id="burger" class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 lg:hidden" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="border-t border-line bg-cream lg:hidden">
    <nav class="container-x grid gap-1 py-4" aria-label="Мобильное меню">
      {NAV.map((n) => <a href={n.href} class="rounded-xl px-3 py-3 text-lg font-medium hover:bg-cream-deep">{n.label}</a>)}
      <a href="/zayavka/" class="rounded-xl px-3 py-3 text-lg font-medium hover:bg-cream-deep">Моя заявка <span class="basket-count-m text-brand"></span></a>
      <div class="mt-3 grid gap-3">
        <a href={SITE.phoneHref} class="text-lg font-bold">{SITE.phone}</a>
        <button type="button" data-lead class="btn btn-primary">Рассчитать смету</button>
        <a href={wa()} class="btn btn-wa" target="_blank" rel="noopener">Написать в WhatsApp</a>
        <a href={tg()} class="btn btn-tg" target="_blank" rel="noopener">Написать в Telegram</a>
        <a href={max()} class="btn btn-max" target="_blank" rel="noopener">Написать в MAX</a>
      </div>
    </nav>
  </div>
</header>
