---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { one, run, audit, hashPassword, verifyPassword } from '../../lib/db';
import { str, back, fmtDate } from '../../lib/admin';
import { killUserSessions, sessionsOf, COOKIE, createSession } from '../../lib/auth';
const u = Astro.locals.user!;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const row = one<any>('SELECT * FROM users WHERE id=?', u.id)!;
  if (str(fd, 'action') === 'name') { run('UPDATE users SET name=? WHERE id=?', str(fd, 'name'), u.id); return Astro.redirect(back('/admin/profile/', 'ok', 'Имя обновлено')); }
  const cur = String(fd.get('current') || ''), n1 = String(fd.get('new') || ''), n2 = String(fd.get('new2') || '');
  if (!verifyPassword(cur, row.password_hash)) return Astro.redirect(back('/admin/profile/', 'err', 'Текущий пароль неверен'));
  if (n1.length < 10) return Astro.redirect(back('/admin/profile/', 'err', 'Новый пароль — не короче 10 символов'));
  if (n1 !== n2) return Astro.redirect(back('/admin/profile/', 'err', 'Пароли не совпадают'));
  run('UPDATE users SET password_hash=? WHERE id=?', hashPassword(n1), u.id);
  killUserSessions(u.id);
  Astro.cookies.set(COOKIE, createSession(u.id, Astro.request.headers.get('user-agent') || '', Astro.clientAddress), { path: '/', httpOnly: true, sameSite: 'strict', secure: Astro.url.protocol === 'https:', maxAge: 7 * 86400 });
  audit(u.login, 'password_change', 'user', u.id);
  return Astro.redirect(back('/admin/profile/', 'ok', 'Пароль изменён, остальные сеансы завершены'));
}
const sess = sessionsOf(u.id);
---
<AdminLayout title="Мой профиль">
  <div class="grid max-w-4xl gap-5 lg:grid-cols-2">
    <form method="post" class="space-y-4 rounded-2xl border border-line bg-white p-6"><input type="hidden" name="action" value="name" /><h2 class="font-sans text-[15px] font-bold">Профиль</h2>
      <p class="text-sm text-ink-soft">Логин: <b class="text-ink">{u.login}</b> · роль: <b class="text-ink">{u.role}</b></p>
      <label class="grid gap-1.5 text-sm font-semibold">Имя<input name="name" value={u.name} class="field" /></label><button class="btn btn-primary">Сохранить</button></form>
    <form method="post" class="space-y-4 rounded-2xl border border-line bg-white p-6"><h2 class="font-sans text-[15px] font-bold">Смена пароля</h2>
      <label class="grid gap-1.5 text-sm font-semibold">Текущий пароль<input name="current" type="password" autocomplete="current-password" required class="field" /></label>
      <label class="grid gap-1.5 text-sm font-semibold">Новый пароль (от 10 символов)<input name="new" type="password" autocomplete="new-password" required minlength="10" class="field" /></label>
      <label class="grid gap-1.5 text-sm font-semibold">Повторите<input name="new2" type="password" autocomplete="new-password" required class="field" /></label><button class="btn btn-primary">Сменить пароль</button></form>
    <section class="rounded-2xl border border-line bg-white p-6 lg:col-span-2"><h2 class="font-sans text-[15px] font-bold">Активные сеансы</h2>
      <ul class="mt-3 divide-y divide-line text-sm">{sess.map((s: any) => <li class="py-2.5"><span class="font-semibold">{fmtDate(s.created_at)}</span> · {s.ip} <span class="text-xs text-ink-soft">· {String(s.ua).slice(0, 80)}</span></li>)}</ul></section>
  </div>
</AdminLayout>
