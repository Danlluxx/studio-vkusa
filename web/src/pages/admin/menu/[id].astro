---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { all, one, run, audit, now } from '../../../lib/db';
import { str, back, fmtDate } from '../../../lib/admin';
import { pic } from '../../../lib/media';
import { saveImage, deleteImage } from '../../../lib/uploads';

const u = Astro.locals.user!;
const isNew = Astro.params.id === 'new';
const id = Number(Astro.params.id);
const it = isNew ? { id: 0, name: '', section: Number(Astro.url.searchParams.get('sec')) || null, price: null, preview: '', price_text: '', detail: '', sort: 500, active: 1, popular: 0, image: '', updated_at: 0 } : one<any>('SELECT * FROM items WHERE id=?', id);
if (!it) return new Response(null, { status: 404 });
const sections = all<any>('SELECT id,name,parent FROM sections ORDER BY parent IS NOT NULL, sort, name');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (str(fd, 'delete') === '1') {
    run('DELETE FROM items WHERE id=?', id); audit(u.login, 'delete', 'item', id, { name: it.name });
    return Astro.redirect(back('/admin/menu/', 'ok', `«${it.name}» удалено`));
  }
  const name = str(fd, 'name');
  if (!name) return Astro.redirect(back(Astro.url.pathname, 'err', 'Укажите название'));
  let image = it.image || '';
  const file = fd.get('photo') as File | null;
  try {
    if (str(fd, 'remove_photo') === '1') { deleteImage(image); image = ''; }
    if (file && file.size) { const old = image; image = await saveImage(file); deleteImage(old); }
  } catch (e: any) { return Astro.redirect(back(Astro.url.pathname, 'err', e.message)); }
  const price = parseFloat(str(fd, 'price').replace(/\s/g, '').replace(',', '.'));
  const vals = [name, Number(str(fd, 'section')) || null, Number.isFinite(price) ? price : null, str(fd, 'preview'), str(fd, 'price_text'), str(fd, 'detail'), Number(str(fd, 'sort')) || 500, str(fd, 'active') ? 1 : 0, str(fd, 'popular') ? 1 : 0, image, now()];
  let nid = id;
  if (isNew) nid = Number(run('INSERT INTO items (name,section,price,preview,price_text,detail,sort,active,popular,image,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)', ...vals).lastInsertRowid);
  else run('UPDATE items SET name=?,section=?,price=?,preview=?,price_text=?,detail=?,sort=?,active=?,popular=?,image=?,updated_at=? WHERE id=?', ...vals, id);
  audit(u.login, isNew ? 'create' : 'update', 'item', nid, { name, price: vals[2] });
  return Astro.redirect(back(`/admin/menu/${nid}/`, 'ok', 'Сохранено'));
}
const p = pic(it.image);
const checked = (v: any) => (v ? true : false);
---
<AdminLayout title={isNew ? 'Новое блюдо' : it.name}>
  <a href="/admin/menu/" class="mb-4 inline-block text-sm font-semibold text-brand">← К списку блюд</a>
  <form method="post" enctype="multipart/form-data" class="grid max-w-5xl gap-5 xl:grid-cols-[1.5fr_1fr]">
    <section class="space-y-4 rounded-2xl border border-line bg-white p-6">
      <label class="grid gap-1.5 text-sm font-semibold">Название<input name="name" value={it.name} required class="field" /></label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-semibold">Раздел<select name="section" class="field"><option value="">— без раздела —</option>{sections.map((x) => <option value={x.id} selected={it.section === x.id}>{x.parent ? '— ' : ''}{x.name}</option>)}</select></label>
        <label class="grid gap-1.5 text-sm font-semibold">Цена, ₽<input name="price" inputmode="decimal" value={it.price ?? ''} class="field" /></label>
        <label class="grid gap-1.5 text-sm font-semibold">Вес / порция<input name="preview" value={it.preview || ''} placeholder="35 гр" class="field" /></label>
        <label class="grid gap-1.5 text-sm font-semibold">Условие заказа<input name="price_text" value={it.price_text || ''} placeholder="Заказ от 10 шт" class="field" /></label>
      </div>
      <label class="grid gap-1.5 text-sm font-semibold">Описание, состав<textarea name="detail" rows="5" class="field">{it.detail || ''}</textarea></label>
      <div class="flex flex-wrap items-center gap-6 text-sm">
        <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="active" checked={isNew ? true : checked(it.active)} class="h-4 w-4 accent-[#d01414]" />Показывать на сайте</label>
        <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="popular" checked={checked(it.popular)} class="h-4 w-4 accent-[#d01414]" />★ Показывать на главной</label>
        <label class="flex items-center gap-2 font-semibold">Порядок<input name="sort" type="number" value={it.sort} class="field !w-24 !py-1.5" /></label>
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-line pt-5">
        <button class="btn btn-primary">{isNew ? 'Добавить блюдо' : 'Сохранить'}</button>
        {!isNew && it.code && <a href={`/menu/`} target="_blank" class="text-sm text-ink-soft underline">Открыть меню на сайте</a>}
        {!isNew && <button name="delete" value="1" data-confirm="Удалить блюдо безвозвратно? Чтобы просто убрать с сайта, снимите галочку «Показывать»." class="ml-auto text-sm text-ink-soft underline hover:text-brand">Удалить</button>}
      </div>
      {!isNew && <p class="text-xs text-ink-soft">Изменено: {fmtDate(it.updated_at)}</p>}
    </section>
    <section class="rounded-2xl border border-line bg-white p-6">
      <h2 class="font-sans text-[15px] font-bold">Фото</h2>
      <div class="mt-3 aspect-[4/3] overflow-hidden rounded-xl bg-cream-deep">
        <img id="ph" src={p ? p.thumb : ''} alt="" class="h-full w-full object-cover" onerror="this.style.display='none'" />
      </div>
      <label class="mt-4 grid gap-1.5 text-sm font-semibold">Загрузить новое<input type="file" name="photo" accept="image/*" data-preview="#ph" class="text-sm" /></label>
      <p class="mt-2 text-xs text-ink-soft">Загружайте оригинал — сайт сам сделает оптимизированные версии (WebP/AVIF трёх размеров). Лучше от 1200 px по длинной стороне.</p>
      {it.image && <label class="mt-3 flex items-center gap-2 text-sm"><input type="checkbox" name="remove_photo" value="1" />Удалить текущее фото</label>}
    </section>
  </form>
</AdminLayout>
