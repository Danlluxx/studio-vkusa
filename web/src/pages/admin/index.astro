---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/admin/Card.astro';
import LineChart from '../../components/admin/LineChart.astro';
import BarList from '../../components/admin/BarList.astro';
import * as A from '../../lib/analytics';
import { all } from '../../lib/db';
import { can } from '../../lib/auth';
import { num, dur, ago, STATUSES } from '../../lib/admin';

const user = Astro.locals.user!;
const r = A.range(Astro.url.searchParams.get('p') || '30');
const k = A.kpis(r), series = A.daily(r), fun = A.funnel(r), ls = A.leadStats(r);
const src = A.sources(r), pages = A.topPages(r), entry = A.entryPages(r), dishes = A.topDishes(r);
const dev = A.devices(r), br = A.browsers(r), os = A.systems(r), hours = A.byHour(r), wd = A.byWeekday(r);
const clicks = A.contactClicks(r), med = A.mediums(r), lpage = A.leadsByPage(r);
const vt = A.vitals(r);
const GR: Record<string, string> = { good: 'bg-emerald-100 text-emerald-900', mid: 'bg-amber-100 text-amber-900', poor: 'bg-red-100 text-red-800', none: 'bg-stone-100 text-stone-500' };
const GRN: Record<string, string> = { good: 'Хорошо', mid: 'Можно лучше', poor: 'Плохо', none: 'Нет данных' };
const fv = (k: string, v: number | null) => (v == null ? '—' : k === 'cls' ? v.toFixed(2) : v >= 1000 ? (v / 1000).toFixed(1) + ' с' : Math.round(v) + ' мс');
const recent = can(user.role, '/admin/leads/') ? all<any>('SELECT id,ts,name,phone,status,source,page FROM leads ORDER BY ts DESC LIMIT 6') : [];
const maxH = Math.max(1, ...hours.map((h) => h.n)), maxW = Math.max(1, ...wd.map((h) => h.n));
const PERIODS: [string, string][] = [['today', 'Сегодня'], ['7', '7 дней'], ['30', '30 дней'], ['90', '90 дней'], ['365', 'Год']];
const DEV: Record<string, string> = { mobile: 'Телефон', desktop: 'Компьютер', tablet: 'Планшет' };
const CK: Record<string, string> = { click_phone: 'Звонок', click_wa: 'WhatsApp', click_tg: 'Telegram', click_max: 'MAX', click_email: 'E-mail' };
const MED: Record<string, string> = { direct: 'Прямые заходы', organic: 'Поиск', social: 'Соцсети', referral: 'Сайты-ссылки', utm: 'Метки (UTM)' };
const delta = (n: number, suffix = '%') => (n === 0 ? '' : `${n > 0 ? '▲' : '▼'} ${num(Math.abs(n), 1)}${suffix}`);
const dcls = (n: number) => (n > 0 ? 'text-emerald-600' : n < 0 ? 'text-red-600' : 'text-ink-soft');
const cards = [
  { t: 'Посетители', v: num(k.visitors), d: k.d.visitors, h: 'Уникальные посетители сайта (по cookie, без личных данных)' },
  { t: 'Просмотры', v: num(k.pageviews), d: k.d.pageviews, h: `${num(k.pagesPerVisit, 1)} стр. за визит` },
  { t: 'Заявки', v: num(k.leads), d: k.d.leads, h: `${ls.nw} новых, ${ls.done} выполнено` },
  { t: 'Конверсия в заявку', v: num(k.conv, 1) + '%', d: k.d.conv, dsuf: ' п.п.', h: 'Заявки / посетители' },
  { t: 'Клики по контактам', v: num(k.contacts), d: 0, h: 'Звонок, WhatsApp, Telegram, MAX, почта' },
  { t: 'Отказы', v: num(k.bounce, 0) + '%', d: 0, h: 'Визиты с одной страницей' },
];
---
<AdminLayout title="Аналитика">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="inline-flex rounded-full border border-line bg-white p-1">
      {PERIODS.map(([key, label]) => <a href={`?p=${key}`} aria-current={r.key === key ? 'page' : undefined} class="rounded-full px-4 py-1.5 text-sm font-semibold text-ink-soft aria-[current=page]:bg-ink aria-[current=page]:text-white">{label}</a>)}
    </div>
    <p class="text-sm text-ink-soft">Сравнение — с предыдущим периодом такой же длины. Данные собирает сам сайт, часовой пояс: Барнаул (UTC+{A.TZ_H}).</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
    {cards.map((c) => (
      <div class="rounded-2xl border border-line bg-white p-5" title={c.h}>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-soft">{c.t}</p>
        <p class="mt-2 font-display text-4xl font-semibold tabular-nums">{c.v}</p>
        <p class="mt-1 flex items-center justify-between text-xs"><span class="text-ink-soft">{c.h}</span></p>
        {c.d !== 0 && <p class:list={['mt-1 text-xs font-semibold', dcls(c.d)]}>{delta(c.d, (c as any).dsuf)} к прошлому периоду</p>}
      </div>
    ))}
  </div>

  <div class="mt-4 grid gap-4 xl:grid-cols-[2fr_1fr]">
    <Card title="Посещаемость и заявки" sub={`${series.length} дн.`}><LineChart data={series} /></Card>
    <Card title="Воронка: от визита до заявки">
      <ol class="space-y-3">
        {fun.map(([name, n], i) => (
          <li>
            <div class="flex justify-between text-sm"><span>{name}</span><b class="tabular-nums">{num(n)}</b></div>
            <div class="mt-1 h-6 overflow-hidden rounded-md bg-cream-deep"><div class="h-full rounded-md bg-brand/85" style={`width:${fun[0][1] ? Math.max(2, (n / fun[0][1]) * 100) : 0}%`}></div></div>
            {i > 0 && fun[i - 1][1] > 0 && <p class="mt-0.5 text-xs text-ink-soft">{num((n / fun[i - 1][1]) * 100, 0)}% от предыдущего шага</p>}
          </li>
        ))}
      </ol>
    </Card>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
    <Card title="Источники трафика" sub="посетители · заявки · конверсия">
      {src.length ? (
        <table class="w-full text-sm"><thead class="text-left text-xs text-ink-soft"><tr><th class="pb-2 font-medium">Источник</th><th class="pb-2 text-right font-medium">Визиты</th><th class="pb-2 text-right font-medium">Заявки</th><th class="pb-2 text-right font-medium">CR</th></tr></thead>
          <tbody class="divide-y divide-line">{src.map((s) => <tr><td class="py-2">{s.source}<span class="ml-1.5 text-xs text-ink-soft">{MED[s.medium] || s.medium}</span></td><td class="py-2 text-right tabular-nums">{num(s.v)}</td><td class="py-2 text-right tabular-nums">{s.leads}</td><td class="py-2 text-right tabular-nums">{num(s.conv, 1)}%</td></tr>)}</tbody></table>
      ) : <p class="text-sm text-ink-soft">Пока нет данных</p>}
    </Card>
    <Card title="Типы источников"><BarList rows={med.map((m) => ({ k: MED[m.k] || m.k, v: m.v }))} /></Card>
    <Card title="Популярные страницы" sub="просмотры · посетители"><BarList rows={pages.map((p) => ({ k: p.path, v: p.pv, sub: `${p.v} посет.`, href: p.path }))} /></Card>
    <Card title="Страницы входа" sub="с каких страниц начинают визит"><BarList rows={entry.map((p) => ({ k: p.path, v: p.c }))} color="bg-ink" /></Card>
    <Card title="Что чаще кладут в заявку" sub="топ блюд"><BarList rows={dishes.map((d) => ({ k: d.name, v: d.c }))} color="bg-emerald-600" empty="Пока никто не добавлял блюда" /></Card>
    <Card title="Контакты: клики"><BarList rows={clicks.map((c) => ({ k: CK[c.k.replace('click_', 'click_')] || c.k, v: c.v }))} color="bg-amber-500" empty="Кликов пока нет" /></Card>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2 xl:grid-cols-4">
    <Card title="Устройства"><BarList rows={dev.map((d) => ({ k: DEV[d.k] || d.k, v: d.v }))} color="bg-ink" /></Card>
    <Card title="Браузеры"><BarList rows={br.map((d) => ({ k: d.k, v: d.v }))} color="bg-ink" /></Card>
    <Card title="Операционные системы"><BarList rows={os.map((d) => ({ k: d.k, v: d.v }))} color="bg-ink" /></Card>
    <Card title="Заявки по страницам"><BarList rows={lpage.map((d) => ({ k: d.k, v: d.v }))} color="bg-emerald-600" empty="Заявок пока нет" /></Card>
  </div>

  <div class="mt-4 grid gap-4 xl:grid-cols-2">
    <Card title="Активность по часам" sub="когда заходят (время Барнаула)">
      <div class="flex h-32 items-end gap-1">{hours.map((h) => <div class="flex-1 rounded-t bg-brand/80" style={`height:${Math.max(3, (h.n / maxH) * 100)}%`} title={`${h.h}:00 — ${h.n}`}></div>)}</div>
      <div class="mt-1 flex justify-between text-[11px] text-ink-soft"><span>0:00</span><span>6:00</span><span>12:00</span><span>18:00</span><span>23:00</span></div>
    </Card>
    <Card title="По дням недели">
      <div class="flex h-32 items-stretch gap-3">{wd.map((h) => <div class="flex h-full flex-1 flex-col items-center justify-end gap-1"><div class="w-full rounded-t bg-ink/80" style={`height:${Math.max(3, (h.n / maxW) * 82)}%`} title={`${h.k}: ${h.n}`}></div><span class="text-xs text-ink-soft">{h.k}</span></div>)}</div>
    </Card>
  </div>

  <Card title="Скорость сайта у реальных посетителей" sub={`${vt.n} замеров · показатель 75% посетителей (как у Google)`} class="mt-4">
    {vt.n ? (
      <div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
          {vt.overall.map((o) => (
            <div class="rounded-xl border border-line p-4" title={A.VITALS[o.k].hint}>
              <p class="text-xs font-semibold text-ink-soft">{A.VITALS[o.k].name}</p>
              <p class="mt-1 font-display text-3xl font-semibold tabular-nums">{fv(o.k, o.v)}</p>
              <p class="mt-1 flex items-center justify-between text-xs"><span class:list={['rounded-full px-2 py-0.5 font-bold', GR[o.grade]]}>{GRN[o.grade]}</span><span class="text-ink-soft">{num(o.goodShare, 0)}% быстрых</span></p>
            </div>
          ))}
        </div>
        <div class="mt-5 grid gap-6 lg:grid-cols-2">
          <div><p class="mb-2 text-xs font-semibold uppercase tracking-wider text-ink-soft">По устройствам</p>
            <table class="w-full text-sm"><thead class="text-left text-xs text-ink-soft"><tr><th class="pb-1 font-medium">Устройство</th><th class="pb-1 text-right font-medium">Замеров</th><th class="pb-1 text-right font-medium">LCP</th><th class="pb-1 text-right font-medium">INP</th><th class="pb-1 text-right font-medium">CLS</th></tr></thead>
              <tbody class="divide-y divide-line">{vt.byDevice.map((d) => <tr><td class="py-1.5">{DEV[d.d] || d.d}</td><td class="py-1.5 text-right tabular-nums">{d.n}</td><td class="py-1.5 text-right tabular-nums">{fv('lcp', d.lcp)}</td><td class="py-1.5 text-right tabular-nums">{fv('inp', d.inp)}</td><td class="py-1.5 text-right tabular-nums">{fv('cls', d.cls)}</td></tr>)}</tbody></table></div>
          <div><p class="mb-2 text-xs font-semibold uppercase tracking-wider text-ink-soft">Самые медленные страницы (LCP)</p>
            <BarList rows={vt.worst.map((w) => ({ k: w.path, v: Math.round(w.lcp!), sub: `${w.n} замер.`, href: w.path }))} color="bg-amber-500" fmt={(n) => (n / 1000).toFixed(1) + ' с'} empty="Нужно хотя бы 3 замера на страницу" /></div>
        </div>
      </div>
    ) : <p class="text-sm text-ink-soft">Замеры появятся, как только посетители начнут заходить на сайт (собираются автоматически, без личных данных).</p>}
  </Card>

  <div class="mt-4 grid gap-4 xl:grid-cols-[1fr_2fr]">
    <Card title="Заявки за период">
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div><dt class="text-ink-soft">Всего</dt><dd class="font-display text-3xl font-semibold">{ls.n}</dd></div>
        <div><dt class="text-ink-soft">Новых</dt><dd class="font-display text-3xl font-semibold text-brand">{ls.nw}</dd></div>
        <div><dt class="text-ink-soft">Выполнено</dt><dd class="font-display text-3xl font-semibold text-emerald-600">{ls.done}</dd></div>
        <div><dt class="text-ink-soft">Отказов</dt><dd class="font-display text-3xl font-semibold">{ls.rej}</dd></div>
        <div><dt class="text-ink-soft">Сумма выполненных</dt><dd class="text-lg font-bold">{num(ls.revenue)} ₽</dd></div>
        <div><dt class="text-ink-soft">Средний чек</dt><dd class="text-lg font-bold">{ls.avg ? num(ls.avg) + ' ₽' : '—'}</dd></div>
        <div class="col-span-2"><dt class="text-ink-soft">Средняя скорость реакции</dt><dd class="text-lg font-bold">{ls.reaction ? dur(ls.reaction) : '—'}</dd></div>
      </dl>
    </Card>
    {recent.length > 0 && (
      <Card title="Последние заявки">
        <ul class="divide-y divide-line">
          {recent.map((l) => (
            <li><a href={`/admin/leads/${l.id}/`} class="flex items-center gap-3 py-3 hover:text-brand">
              <span class:list={['rounded-full px-2.5 py-1 text-xs font-bold', STATUSES[l.status]?.cls]}>{STATUSES[l.status]?.name}</span>
              <span class="font-semibold">{l.name}</span><span class="text-sm text-ink-soft">{l.phone}</span>
              <span class="ml-auto text-xs text-ink-soft">{ago(l.ts)}</span>
            </a></li>
          ))}
        </ul>
        <a href="/admin/leads/" class="mt-3 inline-block text-sm font-semibold text-brand">Все заявки →</a>
      </Card>
    )}
  </div>
</AdminLayout>
