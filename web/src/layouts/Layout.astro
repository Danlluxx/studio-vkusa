---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadDialog from '../components/LeadDialog.astro';
import { SITE, wa, tg, max } from '../lib/site';
import { one } from '../lib/db';
import { getSettings } from '../lib/settings';
import fMan from '../fonts/manrope-cyr.woff2?url';
import fPlay from '../fonts/playfair-cyr.woff2?url';
import fPlayI from '../fonts/playfair-cyr-italic.woff2?url';

interface Props { title: string; description: string; image?: string; noindex?: boolean; ld?: object; crumbs?: [string, string][]; canonical?: string }
const props = Astro.props;
const ov = one<any>('SELECT * FROM seo WHERE path=?', Astro.url.pathname);
const title = ov?.title || props.title, description = ov?.description || props.description, noindex = !!ov?.noindex || props.noindex || false;
const { image = '/og-default.jpg', ld, crumbs } = props;
const cfg = getSettings();
const metrika = getSettings().metrika_id.replace(/\D/g, '');
const canonical = new URL(props.canonical || Astro.url.pathname, Astro.site).href;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const org: Record<string, unknown> = {
  '@context': 'https://schema.org', '@type': 'FoodEstablishment', '@id': abs('/#org'), name: SITE.name, url: site.href,
  telephone: SITE.phone, email: SITE.email, image: abs('/og-default.jpg'), logo: abs('/logo-full.png'),
  address: { '@type': 'PostalAddress', addressLocality: 'Барнаул', addressRegion: 'Алтайский край', streetAddress: 'ул. Интернациональная, 47', addressCountry: 'RU' },
  areaServed: { '@type': 'City', name: 'Барнаул' }, priceRange: SITE.minPrice || 'от 700 ₽',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '12:00', closes: '23:00' },
  ...(SITE.vk ? { sameAs: [SITE.vk] } : {}),
};
const bc = crumbs && crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [['Главная', '/'], ...crumbs].map(([name, url], i) => ({ '@type': 'ListItem', position: i + 1, name, item: abs(url) })),
} : null;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#faf5ee" />
  {cfg.yandex_verification && <meta name="yandex-verification" content={cfg.yandex_verification} />}
  {cfg.google_verification && <meta name="google-site-verification" content={cfg.google_verification} />}
  <link rel="preload" as="font" type="font/woff2" href={fMan} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={fPlay} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={fPlayI} crossorigin />
  <slot name="head" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta property="og:type" content="website" /><meta property="og:locale" content="ru_RU" /><meta property="og:site_name" content="Студия Вкуса" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, Astro.site).href} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  {bc && <script type="application/ld+json" set:html={JSON.stringify(bc)} />}
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">К содержанию</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <LeadDialog />
  <div class="fixed bottom-5 right-5 z-30 flex flex-col gap-3">
    <a href={tg()} target="_blank" rel="noopener" aria-label="Написать в Telegram"
       class="grid h-14 w-14 place-items-center rounded-full bg-[#229ed9] text-white shadow-[0_8px_24px_rgba(0,0,0,.25)] transition hover:scale-105">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.5 3.5 2.6 10.8c-1.3.5-1.3 1.2-.2 1.5l4.8 1.5 1.8 5.6c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.2-.5-1.8-1.1-1.6zM8 13.3l9.6-6c.5-.3.9-.1.5.2l-8 7.2-.3 3.3z"/></svg>
    </a>
  <a href={max()} target="_blank" rel="noopener" aria-label="Написать в MAX"
     class="grid h-14 w-14 place-items-center rounded-full bg-[#7b3ff2] text-sm font-extrabold tracking-tight text-white shadow-[0_8px_24px_rgba(0,0,0,.25)] transition hover:scale-105">MAX</a>
  <a href={wa()} target="_blank" rel="noopener" aria-label="Написать в WhatsApp"
     class="grid h-14 w-14 place-items-center rounded-full bg-[#25d366] text-white shadow-[0_8px_24px_rgba(0,0,0,.25)] transition hover:scale-105">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
  </a>
  </div>
  <div id="cookie-note" hidden role="dialog" aria-label="Использование cookie" class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-xl rounded-3xl border border-line bg-white p-5 shadow-[0_20px_50px_-12px_rgba(26,22,20,.35)] sm:bottom-5 sm:left-5 sm:right-auto sm:mx-0">
    <p class="text-sm leading-relaxed text-ink-soft">Мы используем cookie, чтобы сайт работал удобнее и чтобы понимать, какие страницы полезны гостям. Продолжая пользоваться сайтом, вы соглашаетесь с <a href="/politika-v-otnoshenii-personalnykh-dannykh/" class="underline underline-offset-4 hover:text-brand">политикой обработки данных</a>.</p>
    <button type="button" id="cookie-ok" class="btn btn-primary mt-4 !py-2.5">Понятно</button>
  </div>
  {metrika && <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${metrika},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:false});`} />}
  <script is:inline src="/app.js" defer></script>
</body>
</html>
